# RyanLGriffith.com (Apache). Ignored by `php -S`, which is fine for local testing.
DirectoryIndex index.php
ErrorDocument 404 /404.php

# The old site's static pages now live at PHP addresses; keep old links and search results working.
Redirect 301 /index.html /
Redirect 301 /about.html /about.php
Redirect 301 /demos.html /demos.php
# ...and the old game folders (the games now live in demos/<project-slug>/)
RedirectMatch 301 ^/Demos/density/(.*)$ /demos/density/$1
RedirectMatch 301 ^/Demos/gatsby_game/(.*)$ /demos/gatsby-game/$1
RedirectMatch 301 ^/Demos/rotation_sim/(.*)$ /demos/rotation-simulator/$1
RedirectMatch 301 ^/Demos/the_kingdom/(.*)$ /demos/the-kingdom/$1

# Keep the database and the PHP includes private.
RedirectMatch 404 ^/(data|inc)(/.*)?$
<FilesMatch "(\.(db|sqlite|sqlite3)|README\.md)$">
  Require all denied
</FilesMatch>

AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
